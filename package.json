{
  "name": "gurgel-team-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "npx --yes rimraf .next node_modules/.cache",
    "build:gopro-vendor": "node scripts/build-gopro-vendor.mjs",
    "predev": "node scripts/build-gopro-vendor.mjs",
    "prebuild": "node scripts/build-gopro-vendor.mjs",
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "dev:fresh": "npm run clean && next dev --turbo",
    "build": "next build",
    "build:fresh": "npm run clean && next build",
    "start": "next start",
    "lint": "eslint app components lib sections --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "smoke:http": "npx tsx scripts/smoke-http.ts",
    "smoke:setup": "npx tsx scripts/smoke-setup.ts",
    "smoke:checklist": "npx tsx scripts/smoke-checklist.ts",
    "validate": "npm run db:validate && tsc --noEmit && npm run lint",
    "validate:smoke": "npm run smoke:setup && npm run smoke:checklist",
    "repair:staff-permissions": "npx tsx scripts/repair-staff-permissions.ts",
    "repair:pilot-permissions": "npx tsx scripts/repair-pilot-permissions.ts",
    "repair:week-schedule": "npx tsx scripts/repair-week-schedule.ts",
    "repair:schedule-blocks": "npx tsx scripts/repair-schedule-blocks.ts",
    "repair:schedule-events": "npx tsx scripts/repair-schedule-events.ts",
    "db:studio": "prisma studio",
    "db:migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "gopro-telemetry": "^1.2.11",
    "gpmf-extract": "^0.3.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "swiper": "^12.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.10",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.0"
  }
}
