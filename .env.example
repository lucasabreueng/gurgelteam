# =============================================================================
# Supabase (PostgreSQL)
# Dashboard: Project Settings → Database → Connection string
# =============================================================================
#
# 1. DIRECT_URL — "Direct connection" (porta 5432)
#    Usado por: prisma migrate, prisma db seed
#
# 2. DATABASE_URL — "Transaction pooler" (porta 6543) + ?pgbouncer=true&connection_limit=1
#    Usado por: Next.js em runtime (serverless)
#
# Performance dev: use a URL direta (5432) em DATABASE_URL e DIRECT_URL.
# Performance prod: pooler (6543) em DATABASE_URL; direta (5432) em DIRECT_URL.
#
# Se a senha tiver caracteres especiais (@, #, %…), use URL-encode na string.
#
# Exemplo (substitua [PROJECT-REF], [PASSWORD], [REGION]):
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

DIRECT_URL=
DATABASE_URL=

# =============================================================================
# Supabase — API pública (seguro no frontend com RLS)
# Dashboard: Project Settings → API
# =============================================================================
# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable / anon — NUNCA use service_role ou secret keys aqui
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional — apenas server-side (nunca NEXT_PUBLIC_*)
# SUPABASE_SERVICE_ROLE_KEY=

# Segredo para assinatura de tokens (mín. 32 caracteres em produção)
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Senha dos usuários demo criados por `npm run db:seed`
SEED_DEFAULT_PASSWORD=Gurgel@123

# Protege /admin/* e /piloto/* exigindo cookie de sessão
# false em dev local (mock UI continua funcionando); true em produção
ENABLE_ROUTE_GUARD=false

# Modo de dados: mock (padrão) | http (API v1 + PostgreSQL)
NEXT_PUBLIC_DATA_SOURCE=mock
# NEXT_PUBLIC_DATA_SOURCE=http

# =============================================================================
# E-mail transacional (confirmação de cadastro, recuperação de senha)
# =============================================================================
# Provedor: omita RESEND_API_KEY para log no console (dev) ou defina EMAIL_PROVIDER=console
# Produção: crie conta em https://resend.com, verifique o domínio e use:
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Gurgel Team <contato@gurgelteam.com.br>
RESEND_API_KEY=
EMAIL_FROM=Gurgel Team <contato@gurgelteam.com.br>
# EMAIL_PROVIDER=console

# URL pública do app (links em e-mails de convite e recuperação de senha)
# APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=
