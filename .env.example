# Origem de dados do frontend: mock (padrao) | http (API routes Next ou backend externo)
# NEXT_PUBLIC_DATA_SOURCE=mock
# Para agenda em HTTP com rotas locais Next.js, deixe vazio ou use a origem do app:
# NEXT_PUBLIC_DATA_SOURCE=http
# NEXT_PUBLIC_API_URL=
# Backend externo (futuro):
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Maps (telemetria)
# 1. Ative "Maps JavaScript API" no Google Cloud Console
# 2. Vincule faturamento (Billing) ao projeto
# 3. Em Credentials → restrições da chave → HTTP referrers, inclua:
#    http://localhost:3000/*
#    http://127.0.0.1:3000/*
# 4. Reinicie após alterar: npm run dev
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OCR de cronometragem (foto da planilha S1/S2/S3)
# https://platform.openai.com/api-keys — reinicie após alterar: npm run dev
OPENAI_API_KEY=
# OPENAI_OCR_MODEL=gpt-4o
